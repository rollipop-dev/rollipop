{
  "name": "rollipop",
  "version": "1.0.0-alpha.32",
  "homepage": "https://github.com/rollipop-dev/rollipop#readme",
  "bugs": {
    "url": "https://github.com/rollipop-dev/rollipop/issues"
  },
  "license": "MIT",
  "author": "leegeunhyeok <dev.ghlee@gmail.com> (https://github.com/leegeunhyeok)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rollipop-dev/rollipop.git",
    "directory": "packages/rollipop"
  },
  "bin": "./bin/index.js",
  "files": [
    "client.d.ts",
    "import-glob.d.ts",
    "bin",
    "dist",
    "skills",
    "src/runtime/**"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./filter": {
      "types": "./dist/filter.d.ts",
      "default": "./dist/filter.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./hmr-runtime": "./dist/hmr-runtime.iife.js",
    "./hmr-client": "./src/runtime/hmr-client.ts",
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "vp test --run",
    "execute": "node bin/index.js",
    "build": "vp pack"
  },
  "dependencies": {
    "@babel/code-frame": "8.0.6",
    "@babel/core": "8.0.6",
    "@commander-js/extra-typings": "15.0.0",
    "@devframes/hub": "catalog:devframe",
    "@devframes/hub-ui": "catalog:devframe",
    "@fastify/middie": "9.3.4",
    "@fastify/static": "10.1.4",
    "@inquirer/prompts": "8.7.2",
    "@react-native-community/cli-server-api": "20.2.0",
    "@react-native-community/cli-types": "20.2.0",
    "@react-native/dev-middleware": "0.87.1",
    "@rollipop/dashboard": "workspace:*",
    "@rollipop/rolldown": "catalog:rolldown",
    "@swc/core": "1.16.13",
    "@swc/helpers": "0.5.23",
    "@types/ws": "8.18.1",
    "arktype": "2.2.3",
    "c12": "3.3.4",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "dayjs": "1.11.23",
    "dedent": "1.7.2",
    "devframe": "catalog:devframe",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "es-toolkit": "catalog:",
    "fast-flow-transform": "0.0.3",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "gradient-string": "3.0.0",
    "image-size": "2.0.4",
    "json-schema-to-ts": "3.1.1",
    "mime": "4.1.0",
    "mitt": "3.0.1",
    "open": "11.0.4",
    "pretty-format": "30.5.1",
    "rolldown-analyzer": "0.3.1",
    "source-map": "0.8.0",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@devframes/agentic": "catalog:devframe",
    "@swc/plugin-remove-console": "15.0.0",
    "@types/react-refresh": "0.14.7",
    "@vitest/coverage-v8": "catalog:vp",
    "react-refresh": "0.19.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:vp",
    "vitest": "catalog:vp"
  },
  "peerDependencies": {
    "@devframes/agentic": "1.0.0"
  },
  "peerDependenciesMeta": {
    "@devframes/agentic": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "installConfig": {
    "hoistingLimits": "none"
  }
}
